# ===========================
# Tournament Management System
# Backend Environment Config (Template)
# ===========================

# Server
PORT=5000
NODE_ENV=production

# Database (Option A: Connection string from Cloud MySQL / Render / Aiven / TiDB)
# DATABASE_URL=mysql://username:password@hostname:3306/databasename

# Database (Option B: Individual parameters)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=tournamentData
DB_SSL=false

# Automatically apply schema.sql & seed default admin on deploy
AUTO_MIGRATE=true

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS (Frontend URL on Render, e.g. https://your-frontend.onrender.com)
FRONTEND_URL=https://your-frontend.onrender.com
